# RoastMyWallet — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings → API → anon / public key  (safe to bundle in the app)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── RevenueCat (optional — required for paid subscriptions) ──────────────────
# https://app.revenuecat.com → Project → API Keys → Public SDK key
EXPO_PUBLIC_REVENUECAT_API_KEY=

# ─── Feature flags ────────────────────────────────────────────────────────────
APP_ENV=development
AI_ENABLED=true

# ─── EAS ──────────────────────────────────────────────────────────────────────
# Set automatically by EAS Build — leave blank for local dev
EAS_PROJECT_ID=
