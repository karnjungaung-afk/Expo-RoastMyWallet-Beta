{
  "expo": {
    "name": "RoastMyWallet",
    "slug": "roastmywallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3557"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roastmywallet.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RoastMyWallet \u0e43\u0e0a\u0e49 photo library \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e41\u0e19\u0e1a\u0e23\u0e39\u0e1b\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e32\u0e01\u0e0b\u0e37\u0e49\u0e2d",
        "NSCameraUsageDescription": "RoastMyWallet \u0e43\u0e0a\u0e49\u0e01\u0e25\u0e49\u0e2d\u0e07\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e16\u0e48\u0e32\u0e22\u0e23\u0e39\u0e1b\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e32\u0e01\u0e0b\u0e37\u0e49\u0e2d",
        "NSUserNotificationUsageDescription": "RoastMyWallet \u0e2a\u0e48\u0e07 reminder \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e0a\u0e48\u0e27\u0e22\u0e15\u0e31\u0e14\u0e2a\u0e34\u0e19\u0e43\u0e08\u0e01\u0e48\u0e2d\u0e19\u0e0b\u0e37\u0e49\u0e2d\u0e02\u0e2d\u0e07",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "associatedDomains": [
        "applinks:roastmywallet.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3557"
      },
      "package": "com.roastmywallet.app",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "mimeType": "text/plain",
          "category": [
            "android.intent.category.DEFAULT"
          ]
        },
        {
          "action": "android.intent.action.VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "roastmywallet"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        },
        {
          "action": "android.intent.action.VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "shopee.co.th"
            },
            {
              "scheme": "https",
              "host": "lazada.co.th"
            },
            {
              "scheme": "https",
              "host": "www.tiktok.com"
            },
            {
              "scheme": "https",
              "host": "shein.com"
            },
            {
              "scheme": "https",
              "host": "aliexpress.com"
            },
            {
              "scheme": "https",
              "host": "amazon.com"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B3557",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "roastmywallet",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}